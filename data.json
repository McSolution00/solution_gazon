let selection = [];

const content = {
    'small-lot': {
        fr: `<h3>Petit terrain (35$)</h3>
             <p>Inclus : Tonte, soufflage, finition des bordures et bordure une fois par mois.</p>
             <p><strong>Détails :</strong> Taxes en sus. Prix par visite.</p>
             <button class="btn-call" onclick="addItem('Petit terrain / Small Lot (35$)')">Ajouter / Add</button>`,
        en: `<h3>Small Lot ($35)</h3>
             <p>Included: Mowing, trimming, blowing and once a month edging.</p>
             <p><strong>Details:</strong> Plus taxes. Per visit.</p>`
    },
    'custom-quote': {
        fr: `<h3>Terrain Standard</h3>
             <p>Inclus : Tonte, soufflage, finition des bordures et bordure une fois par mois.</p>
             <p><strong>Note :</strong> Veuillez inclure votre adresse et la taille du terrain dans le courriel pour une estimation.</p>
             <button class="btn-call" onclick="addItem('Estimation: Terrain Standard / Standard Lot')">Ajouter / Add</button>`,
        en: `<h3>Standard Lot</h3>
             <p>Included: Mowing, trimming, blowing and once a month edging.</p>
             <p><strong>Note:</strong> Please include your address and lawn size in the email to receive an estimate.</p>`
    }
};

const addonsList = [
    { fr: "Nettoyage printanier", en: "Spring cleanup" },
    { fr: "Aération et déchaumage", en: "Aeration and dethatching" },
    { fr: "Contrôle des mauvaises herbes", en: "Weed control" },
    { fr: "Fertilisation écologique", en: "Eco-friendly fertilization" },
    { fr: "Nettoyage des dommages hivernaux", en: "Winter damage repair" },
    { fr: "Traitements vers blancs & punaises", en: "White grub & chinch bug treatment" },
    { fr: "Pose de gazon en rouleaux", en: "Sod installation" }
];

function openModal(id) {
    const overlay = document.getElementById('modal-overlay');
    const body = document.getElementById('modal-body');
    
    if (id === 'addons-modal') {
        let html = '<h3>Services Additionnels / Add-ons</h3>';
        addonsList.forEach((item, index) => {
            const label = `${item.fr} / ${item.en}`;
            const checked = selection.includes(label) ? 'checked' : '';
            html += `
                <div class="addon-row">
                    <input type="checkbox" id="add-${index}" ${checked} onchange="toggleAddon('${label}')">
                    <label for="add-${index}">${item.fr} <br> <small>${item.en}</small></label>
                </div>`;
        });
        body.innerHTML = html;
    } else {
        body.innerHTML = content[id].fr + "<hr>" + content[id].en;
    }
    overlay.style.display = 'flex';
}

function closeModal() {
    document.getElementById('modal-overlay').style.display = 'none';
}

function addItem(item) {
    if (!selection.includes(item)) selection.push(item);
    updateDisplay();
    closeModal();
}

function toggleAddon(item) {
    const idx = selection.indexOf(item);
    if (idx > -1) selection.splice(idx, 1);
    else selection.push(item);
    updateDisplay();
}

function updateDisplay() {
    const display = document.getElementById('cart-display');
    if (selection.length === 0) {
        display.innerHTML = '<p>Aucun service sélectionné / No services selected</p>';
    } else {
        display.innerHTML = '<ul>' + selection.map(i => `<li>${i}</li>`).join('') + '</ul>';
    }
}

function sendFinalEmail() {
    if (selection.length === 0) {
        alert("Veuillez choisir un service avant de continuer. / Please choose a service first.");
        return;
    }
    const email = "glscape1@hotmail.com";
    const subject = encodeURIComponent("Demande d'estimation - MC Solution Gazon");
    const body = encodeURIComponent(
        "Bonjour / Hello,\n\n" +
        "Je souhaite recevoir une estimation pour :\n" +
        "I would like to receive a quote for:\n\n" +
        selection.join("\n") + 
        "\n\nMon adresse / My address:\n" +
        "Taille du terrain / Lawn size:"
    );
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
}
